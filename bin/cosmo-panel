#!/usr/bin/env python3
"""RedGear Cosmo 7.1 control panel (light GTK3)."""
import os, signal, subprocess, sys
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
sys.path.insert(0, os.path.expanduser("~/.local/share/redgear-cosmo/lib"))
import cosmolib as C
import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib
SHARE = None

class Panel(Gtk.Window):
    def __init__(self):
        super().__init__(title="RedGear Cosmo 7.1")
        self.set_default_size(420, 1); self.set_border_width(10)
        self.c = C.load(); self.eq_scales = []; self.dist_scales = []; self.pending = None
        nb = Gtk.Notebook(); self.add(nb)
        nb.append_page(self.playback_tab(), Gtk.Label(label="Playback"))
        nb.append_page(self.effects_tab(), Gtk.Label(label="Equalizer"))
        nb.append_page(self.virtual_tab(), Gtk.Label(label="Virtual 7.1"))
        nb.append_page(self.mic_tab(), Gtk.Label(label="Microphone"))
        self.connect("destroy", Gtk.main_quit)

    def grid(self):
        g = Gtk.Grid(row_spacing=10, column_spacing=12, margin=10); g.r = 0; return g
    def slider(self, g, label, val, cb, lo=0, hi=100, step=1):
        g.attach(Gtk.Label(label=label, xalign=0), 0, g.r, 1, 1)
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_hexpand(True); s.set_value(val); s.connect("value-changed", cb)
        g.attach(s, 1, g.r, 1, 1); g.r += 1; return s
    def toggle(self, g, label, on, cb):
        g.attach(Gtk.Label(label=label, xalign=0), 0, g.r, 1, 1)
        sw = Gtk.Switch(active=on, halign=Gtk.Align.END); sw.connect("notify::active", cb)
        g.attach(sw, 1, g.r, 1, 1); g.r += 1; return sw

    def commit(self):
        """Save config and tell the daemon to reload (debounced)."""
        if self.pending: GLib.source_remove(self.pending)
        def go():
            self.pending = None; C.save(self.c)
            p = C.daemon_pid()
            if p: os.kill(p, signal.SIGHUP)
            else: subprocess.Popen([os.path.expanduser("~/.local/bin/cosmo-daemon")])
            return False
        self.pending = GLib.timeout_add(600, go)

    def set(self, k, v): self.c[k] = v; self.commit()

    def playback_tab(self):
        g = self.grid()
        v, on = C.amget("Speaker")
        self.slider(g, "Volume", v, lambda s: C.amix("Speaker", f"{int(s.get_value())}%"))
        self.toggle(g, "Mute", not on, lambda s, _: C.amix("Speaker", "mute" if s.get_active() else "unmute"))
        self.slider(g, "Bass boost (dB)", self.c["bass"], lambda s: self.set("bass", int(s.get_value())), 0, 12)
        self.toggle(g, "Karaoke (reduce vocals)", self.c["karaoke"], lambda s, _: self.set("karaoke", s.get_active()))
        return g

    def effects_tab(self):
        g = self.grid()
        g.attach(Gtk.Label(label="Profile", xalign=0), 0, g.r, 1, 1)
        cb = Gtk.ComboBoxText()
        for p in C.PROFILES: cb.append_text(p)
        cb.set_active(list(C.PROFILES).index(self.c["profile"]) if self.c["profile"] in C.PROFILES else 0)
        cb.connect("changed", self.on_profile); g.attach(cb, 1, g.r, 1, 1); g.r += 1
        for i, f in enumerate(C.BANDS):
            lab = f"{f} Hz" if f < 1000 else f"{f // 1000} kHz"
            s = self.slider(g, lab, self.c["eq"][i], lambda s, i=i: self.on_eq(i, s), -12, 12)
            self.eq_scales.append(s)
        return g
    def on_profile(self, cb):
        name = cb.get_active_text(); self.c["profile"] = name
        self.c["eq"] = list(C.PROFILES[name])
        for s, v in zip(self.eq_scales, self.c["eq"]): s.set_value(v)
        self.commit()
    on_eq_dummy = None
    def on_eq(self, i, s):
        self.c["eq"][i] = int(s.get_value()); self.commit()

    def virtual_tab(self):
        g = self.grid()
        self.toggle(g, "Virtual 7.1 speakers (headphone surround)", self.c["virtual71"],
                    lambda s, _: self.set("virtual71", s.get_active()))
        for i, (name, az, _) in enumerate(C.SPEAKERS):
            row = Gtk.Box(spacing=8)
            s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 50, 1)
            s.set_hexpand(True); s.set_value(self.c["dist"][i])
            s.connect("value-changed", lambda s, i=i: (self.c["dist"].__setitem__(i, int(s.get_value())), self.commit()))
            b = Gtk.Button(label="Test"); b.connect("clicked", lambda _, i=i: C.speaker_test(i, SHARE))
            g.attach(Gtk.Label(label=f"{name} distance", xalign=0), 0, g.r, 1, 1)
            row.pack_start(s, True, True, 0); row.pack_start(b, False, False, 0)
            g.attach(row, 1, g.r, 1, 1); g.r += 1
        return g

    def mic_tab(self):
        g = self.grid()
        v, on = C.amget("Mic")
        self.slider(g, "Mic volume", v, lambda s: C.amix("Mic", f"{int(s.get_value())}%", "cap"))
        self.toggle(g, "Mic mute", not on, lambda s, _: C.amix("Mic", "nocap" if s.get_active() else "cap"))
        self.toggle(g, "Auto gain control", C.amget("Auto Gain Control")[1],
                    lambda s, _: C.amix("Auto Gain Control", "on" if s.get_active() else "off"))
        self.slider(g, "Mic boost (dB)", self.c["mic_boost"], lambda s: self.set("mic_boost", int(s.get_value())), 0, 20)
        self.toggle(g, "Noise reduction", self.c["mic_nr"], lambda s, _: self.set("mic_nr", s.get_active()))
        return g

if __name__ == "__main__":
    if not C.card():
        print("Cosmo headphone not found"); sys.exit(1)
    if not C.daemon_pid():
        subprocess.Popen([os.path.expanduser("~/.local/bin/cosmo-daemon")])
    Panel().show_all(); Gtk.main()
